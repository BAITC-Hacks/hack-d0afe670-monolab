# Talap backend — copy to .env

# PostgreSQL (dedicated Talap DB — NOT TenderAI)
DATABASE_URL=postgresql://talap:talap@localhost:5433/talap

# Match uses TenderAI DB only (default). Goszakup is opt-in:
# GOSZAKUP_LIVE_ENRICH_ENABLED=0
# GOSZAKUP_INGEST_ENABLED=0
GOSZAKUP_TOKEN=

# Optional LLM polish for заявление (copy OPENAI_API_KEY from tenderai-backend)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# COMPLAINT_LLM_ENABLED=1

# Yandex Maps/Geocoder (same key as frontend — for warranty road markers)
YANDEX_MAPS_API_KEY=

# Frontend dev server origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional
ROAD_WARRANTY_YEARS_DEFAULT=3
NOMINATIM_USER_AGENT=Talap/1.0 (road warranty lookup)
DATABASE_SSL=0

# Ingest rate limits (polite Goszakup usage)
INGEST_WINDOW_DAYS=14
INGEST_DELAY_SECONDS=2.0
INGEST_PAGE_LIMIT=100
INGEST_MAX_WINDOWS=6

# Read-only import from TenderAI Postgres (copy DATABASE_URL from tenderai-backend/.env)
TENDERAI_DATABASE_URL=

# ── Road defect CV (YOLO26) ───────────────────────────────────────────────────
CV_MODEL_PATH=training/weights/best.pt
CV_CONFIDENCE_THRESHOLD=0.4
CV_POTHOLE_HAZARD_AREA_RATIO=0.02
CV_MAX_IMAGE_BYTES=10485760
USE_MODAL=false
MODAL_CV_APP_NAME=talap-cv
MODAL_CV_FUNCTION_NAME=detect

# Complaint gateway: internal | smart_bridge (future)
GOV_GATEWAY=internal
# Warranty match DB: all | tenderai | goszakup
MATCH_DATA_SOURCE=all
SPECIALIST_API_KEY=change-me-strong-secret
